{
  "name": "agronomist-assistant-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-model.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/test-scenarios.mjs",
    "prepare:model": "node scripts/prepare-model.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:model": "node --test tests/model-package.test.mjs && playwright test model-smoke",
    "evaluate:model": "node scripts/evaluate-model.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "onnxruntime-web": "1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.4",
    "vitest": "4.1.11"
  }
}
